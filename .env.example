# Local Supabase (from `npx supabase status`). Copy to .env.local and fill in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Only used for teammate-invite emails (src/server/email/sendInviteEmail.ts).
# NOT used for sign-in/magic-link auth -- that's Supabase Auth's own mailer
# (see README "Auth email delivery"). Leave blank to just log the invite
# link to the server console instead of sending it.
RESEND_API_KEY=
# Optional. Defaults to Resend's sandbox sender, which only delivers to your
# own Resend account email until you verify a domain.
RESEND_FROM_EMAIL=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google connector (Gmail + Calendar, read-only). From a Google Cloud
# project's OAuth client (console.cloud.google.com -> APIs & Services ->
# Credentials). Leave blank to no-op the Google connector in CI/local dev
# rather than throwing at import time.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/connectors/google/callback

# Microsoft connector (Outlook Mail + Calendar, read-only). From a
# multi-tenant Entra app registration (entra.microsoft.com -> App
# registrations -> New registration -> "Accounts in any organizational
# directory and personal Microsoft accounts"). Leave blank to no-op the
# Microsoft connector, same as the Google vars above.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3000/api/connectors/microsoft/callback
# Optional. Defaults to the "common" authority, which accepts both work/
# school and personal Microsoft accounts. Only set this if your Entra app
# registration restricts sign-in to a single tenant or organizations only.
MICROSOFT_OAUTH_AUTHORITY=

# Slack connector (channels + mentions, read-only, no DMs, no bot
# posting). From a Slack app (api.slack.com/apps -> Create New App ->
# OAuth & Permissions). Leave blank to no-op the Slack connector, same as
# the Google/Microsoft vars above.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=http://localhost:3000/api/connectors/slack/callback

# Gmail push notifications (src/server/connectors/google/webhook.ts). Needs
# a deployed HTTPS URL to register a watch() against -- leave blank until
# one exists; the webhook route still works without these, it just never
# receives real traffic.
# The Cloud Pub/Sub topic Gmail publishes to, e.g.
# projects/<project>/topics/gmail-push.
GOOGLE_PUBSUB_TOPIC=
# Must exactly equal this endpoint's own deployed URL -- Pub/Sub's push
# OIDC token is issued with this as its audience, and the webhook rejects
# any token whose audience doesn't match.
GOOGLE_PUBSUB_AUDIENCE=
# Optional. If set, the webhook also checks the OIDC token's email claim
# against this, rejecting tokens from any other service account.
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=

# Microsoft Graph change notifications
# (src/server/connectors/microsoft/webhook.ts). Same deployed-URL
# prerequisite as the Pub/Sub vars above.
# This app's own deployed webhook URL, e.g.
# https://<your-domain>/api/webhooks/microsoft/graph.
MICROSOFT_GRAPH_NOTIFICATION_URL=
# An arbitrary secret you choose -- Graph echoes it back on every
# notification (its only authentication mechanism, no per-request
# signature exists). Generate with `openssl rand -hex 32`.
MICROSOFT_GRAPH_CLIENT_STATE=

# Shared secret for app/api/cron/renew-watches, which re-registers Gmail
# watches / Graph subscriptions before they expire. Generate with
# `openssl rand -hex 32`. Whatever calls this route (Vercel Cron,
# pg_cron+pg_net) must send `Authorization: Bearer <this value>`.
CRON_SECRET=

# AES-256-GCM key (base64) encrypting connected_account_secrets' stored
# OAuth tokens. Generate with `openssl rand -base64 32`. Must also be set
# via `supabase secrets set` for Edge Functions that decrypt these tokens
# (separate store from Vercel/`.env.local`).
TOKEN_ENCRYPTION_KEY=
# Which key version new encryptions use (defaults to 1, matching
# TOKEN_ENCRYPTION_KEY). Rotate by setting TOKEN_ENCRYPTION_KEY_V2 etc.
# alongside the old key (never remove it -- old rows still need it to
# decrypt) and bumping this.
TOKEN_ENCRYPTION_KEY_VERSION=
