# Local Supabase (from `npx supabase status`). Copy to .env.local and fill in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Only used for teammate-invite emails (src/server/email/sendInviteEmail.ts).
# NOT used for sign-in/magic-link auth -- that's Supabase Auth's own mailer
# (see README "Auth email delivery"). Leave blank to just log the invite
# link to the server console instead of sending it.
RESEND_API_KEY=
# Optional. Defaults to Resend's sandbox sender, which only delivers to your
# own Resend account email until you verify a domain.
RESEND_FROM_EMAIL=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
